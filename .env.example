# Production Postgres (Neon / Supabase). Without this, the app uses embedded PGLite.
DATABASE_URL=

# Private staff microsite. Separate multiple approved Google emails with commas.
ATHRECS_STAFF_EMAILS=owner@example.com
ATHRECS_STAFF_HOST=update.athrecs.com
VITE_STAFF_SITE_URL=https://update.athrecs.com

# Production authentication (configure these for the Production environment).
VITE_AUTH_ENABLED=true
BETTER_AUTH_URL=https://update.athrecs.com
BETTER_AUTH_SECRET=
# Google Cloud OAuth 2.0 Web application credentials. Register this callback:
# https://update.athrecs.com/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional broker credentials for non-Google providers. The baked fallback is
# preview-only and is never used on a deployment with BETTER_AUTH_URL set.
GROK_AUTH_CLIENT_ID=
GROK_AUTH_CLIENT_SECRET=
# GROK_AUTH_ISSUER=

# Random production-only salt used to one-way hash opted-in analytics sessions.
ATHRECS_ANALYTICS_SALT=
