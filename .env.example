# Production Postgres (Neon / Supabase). Without this, the app uses embedded PGLite.
DATABASE_URL=

# Private staff microsite. Separate multiple approved Google emails with commas.
ATHRECS_STAFF_EMAILS=owner@example.com
ATHRECS_STAFF_HOST=update.athrecs.com
VITE_STAFF_SITE_URL=https://update.athrecs.com

# Production authentication.
# Email/password remains available when enabled. Other methods appear only when
# every credential required for that provider is present.
VITE_AUTH_ENABLED=true
BETTER_AUTH_URL=https://www.athrecs.com
BETTER_AUTH_SECRET=

# Optional transactional email for verification, verification resend and
# password recovery. Basic email/password creation and sign-in do not depend on
# these variables. AUTH_EMAIL_FROM must use a Resend-verified sender/domain.
RESEND_API_KEY=
AUTH_EMAIL_FROM=ATHRECS Accounts <accounts@athrecs.com>

# Google. Register these callback URLs:
# https://www.athrecs.com/api/auth/callback/google
# https://athrecs.com/api/auth/callback/google
# https://update.athrecs.com/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sign in with Apple. The Service ID is APPLE_CLIENT_ID. Store the complete .p8
# private key, preserving line breaks or replacing them with literal \n sequences.
# Return URLs:
# https://www.athrecs.com/api/auth/callback/apple
# https://athrecs.com/api/auth/callback/apple
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# Optional native iOS bundle identifier.
APPLE_APP_BUNDLE_IDENTIFIER=

# Microsoft personal/work accounts. Register both public callbacks:
# https://www.athrecs.com/api/auth/callback/microsoft
# https://athrecs.com/api/auth/callback/microsoft
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Facebook Login:
# https://www.athrecs.com/api/auth/callback/facebook
# https://athrecs.com/api/auth/callback/facebook
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# X OAuth 2.0. Optional later provider; enable user.email scope before use:
# https://www.athrecs.com/api/auth/callback/twitter
# https://athrecs.com/api/auth/callback/twitter
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# LinkedIn OpenID Connect:
# https://www.athrecs.com/api/auth/callback/linkedin
# https://athrecs.com/api/auth/callback/linkedin
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Optional broker credentials used by approved preview or brokered providers.
# The baked fallback is preview-only and is never used on a permanent deployment
# with BETTER_AUTH_URL unless these credentials are supplied.
GROK_AUTH_CLIENT_ID=
GROK_AUTH_CLIENT_SECRET=
# GROK_AUTH_ISSUER=

# Random production-only salt used to one-way hash opted-in analytics sessions.
ATHRECS_ANALYTICS_SALT=
